{
  "name": "tsukuru",
  "version": "0.5.0",
  "description": "vocabulary and concept randomizer for Japanese sentence construction review",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "scrape": "cd ./apps-uv/kezuru/ && uv run main.py",
